            "beside"
          ]
        },
        {
          "name": "introAlign",
          "values": [
            "left",
            "center",
            "right"
          ]
        },
        {
          "name": "sidePosition",
          "values": [
            "left",
            "right",
            "bottom"
          ]
        },
        {
          "name": "form",
          "values": [
            "none",
            "teaser",
            "full"
          ]
        },
        {
          "name": "formStyle",
          "values": [
            "plain",
            "card"
          ]
        },
        {
          "name": "image",
          "values": [
            "none",
            "yes"
          ]
        },
        {
          "name": "itemsLayout",
          "values": [
            "grid",
            "list"
          ],
