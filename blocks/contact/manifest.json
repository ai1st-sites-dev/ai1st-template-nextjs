        },
        {
          "name": "itemStyle",
          "values": [
            "plain",
            "card"
          ]
        },
        {
          "name": "itemAlign",
          "values": [
            "left",
            "center"
          ]
        },
        {
          "name": "itemIcon",
          "values": [
            "left",
            "top"
          ]
        },
        {
