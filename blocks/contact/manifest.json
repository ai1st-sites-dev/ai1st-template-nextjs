          "values": [
            "card",
            "plain"
          ]
        },
        {
          "name": "map",
          "values": [
            "none",
            "beside",
            "bottom"
          ]
        }
      ]
    },
    "introEyebrow": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{text, style: \"none\" | \"pill\" | \"outline\" | \"dash\" | \"plain\"}",
      "editLabel": {
        "text": "Eyebrow"
      },
      "choices": {
        "style": [
          "none",
          "pill",
          "outline",
          "dash",
          "plain"
        ]
      }
    },
    "headline": {
      "kind": "text",
      "required": true,
      "promptOptional": false,
      "editLabel": "Headline"
    },
    "body": {
      "kind": "text",
      "required": false,
      "promptOptional": true,
      "editLabel": "Text"
    },
    "items": {
      "kind": "list",
      "required": false,
      "promptOptional": true,
      "maxItems": 6,
      "shape": "[{kind: \"phone\" | \"email\" | \"address\" | \"hours\" | \"link\", title, hint?, href?}]",
      "editLabel": {
        "title": "Title",
        "hint": "Hint"
      },
      "itemChoices": {
        "kind": [
          "phone",
          "email",
          "address",
          "hours",
          "link"
        ]
      },
      "itemNeeds": {
        "kind=link": [
          "href"
        ]
      }
    },
    "form": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{id?}"
    },
    "image": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{imageUrl, alt}",
      "editLabel": "Image"
    },
    "location": {
      "kind": "text",
      "required": false,
      "promptOptional": true
    },
    "bg": { "ref": "bg" }
  },
  "industries": {
    "required": [],
    "recommended": [
      "plumbing",
      "roofing",
      "landscaping",
      "cleaning",
      "construction"
    ],
    "discouraged": []
  },
  "prompt": {
    "group": "homepage",
    "order": 19,
    "headPrefix": "",
    "headSuffix": "a block head, a group of contact items (phone / email / address / hours / link) and a side column with the lead form and an optional map, one group per location when the site has more than one, with presets for form beside, location cards, photo beside, map beside and compact",
    "headExtra": null,
    "lines": [
      "@data",
      "items: only pick the kinds the site data really has (phone / email / address / hours); the value itself is read from the site data and shown under the title, so title and hint must NOT contain the phone number, email, address or opening hours (a copied value is removed) — title says what it is (\"Call us\"), hint says something else (\"Same-day reply\", \"Free parking\"); only kind link has an href (WhatsApp, booking page)",
      "if the business has no real street address, do not use the preset with a map (Map beside)",
      "image is a photo of the shop front shown in the side column (the image knob turns it on); location is left empty — location pages fill it with one location id",
      "form picks the site's lead form (leave id empty for the default form); how much of it shows is the form knob",
      "bg is the background colour, top-level in data (not inside options)"
    ]
  },
  "toolbarGroups": [
    ["introPosition", "introAlign", "choice:introEyebrow.style"],
    ["sidePosition", "form", "formStyle", "image"],
    ["itemsLayout", "itemStyle", "itemAlign", "itemIcon"],
    ["locationsLayout", "locationStyle"],
    ["map"],
    ["color:bg"]
  ],
  "introLayout": {
    "text": ".ct-intro-text",
    "follow": [
      {"target": ".ct-sidecol .ct-form", "by": "margin", "when": "[data-side-position=\"bottom\"]"}
    ]
  }
}
