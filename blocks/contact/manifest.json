{
  "type": "contact",
  "displayName": "Contact (Webpixels)",
  "category": "contact",
  "roleDefault": "essential",
  "skin": "site-css",
  "layout_intent": {
    "items": "stack",
    "item_wrap": "allow",
    "headline": "above",
    "cross": "none",
    "order": "dom",
    "item_parts": "stack",
    "inner": "many"
  },
  "presets": [
    {
      "name": "Form beside",
      "shape": "form-beside",
      "knobs": {
        "introPosition": "beside",
        "introAlign": "left",
        "sidePosition": "right",
        "form": "full",
        "formStyle": "card",
        "itemsLayout": "list",
        "itemStyle": "plain",
        "itemAlign": "left",
        "itemIcon": "left",
        "map": "none"
      }
    },
    {
      "name": "Details beside",
      "shape": "details-beside",
      "knobs": {
        "introPosition": "top",
        "introAlign": "center",
        "sidePosition": "left",
        "form": "full",
        "formStyle": "plain",
        "itemsLayout": "list",
        "itemStyle": "plain",
        "itemAlign": "left",
        "itemIcon": "left",
        "map": "none"
      }
    },
    {
      "name": "Stacked",
      "shape": "stacked",
      "knobs": {
        "introPosition": "top",
        "introAlign": "center",
        "sidePosition": "bottom",
        "form": "full",
        "formStyle": "card",
        "itemsLayout": "grid",
        "itemStyle": "card",
        "itemAlign": "center",
        "itemIcon": "top",
        "map": "none"
      }
    },
    {
      "name": "Map beside",
      "shape": "map-beside",
      "knobs": {
        "introPosition": "beside",
        "introAlign": "left",
        "sidePosition": "right",
        "form": "none",
        "formStyle": "card",
        "itemsLayout": "list",
        "itemStyle": "plain",
        "itemAlign": "left",
        "itemIcon": "left",
        "map": "beside"
      }
    },
    {
      "name": "Map",
      "shape": "map",
      "knobs": {
        "introPosition": "top",
        "introAlign": "center",
        "sidePosition": "right",
        "form": "none",
        "formStyle": "card",
        "itemsLayout": "grid",
        "itemStyle": "card",
        "itemAlign": "center",
        "itemIcon": "top",
        "map": "bottom"
      }
    }
  ],
  "slots": {
    "options": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{introPosition, introAlign, sidePosition, form, formStyle, itemsLayout, itemStyle, itemAlign, itemIcon, map}",
      "knobs": [
        {
          "name": "introPosition",
          "values": [
            "top",
            "beside"
          ]
        },
        {
          "name": "introAlign",
          "values": [
            "left",
            "center",
            "right"
          ]
        },
        {
          "name": "sidePosition",
          "values": [
            "left",
            "right",
            "bottom"
          ]
        },
        {
          "name": "form",
          "values": [
            "none",
            "teaser",
            "full"
          ]
        },
        {
          "name": "formStyle",
          "values": [
            "plain",
            "card"
          ]
        },
        {
          "name": "itemsLayout",
          "values": [
            "grid",
            "list"
          ],
          "default": "list"
        },
        {
          "name": "itemStyle",
          "values": [
            "plain",
            "card"
          ]
        },
        {
          "name": "itemAlign",
          "values": [
            "left",
            "center"
          ]
        },
        {
          "name": "itemIcon",
          "values": [
            "left",
            "top"
          ]
        },
        {
          "name": "map",
          "values": [
            "none",
            "beside",
            "bottom"
          ]
        }
      ]
    },
    "introEyebrow": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{text, style: \"none\" | \"pill\" | \"outline\" | \"dash\" | \"plain\"}",
      "editLabel": {
        "text": "Eyebrow"
      },
      "choices": {
        "style": [
          "none",
          "pill",
          "outline",
          "dash",
          "plain"
        ]
      }
    },
    "headline": {
      "kind": "text",
      "required": true,
      "promptOptional": false,
      "editLabel": "Headline"
    },
    "body": {
      "kind": "text",
      "required": false,
      "promptOptional": true,
      "editLabel": "Text"
    },
    "items": {
      "kind": "list",
      "required": false,
      "promptOptional": true,
      "maxItems": 6,
      "shape": "[{kind: \"phone\" | \"email\" | \"address\" | \"hours\" | \"link\", title, hint?, href?}]",
      "editLabel": {
        "title": "Title",
        "hint": "Hint"
      },
      "itemChoices": {
        "kind": [
          "phone",
          "email",
          "address",
          "hours",
          "link"
        ]
      },
      "itemNeeds": {
        "kind=link": [
          "href"
        ]
      }
    },
    "form": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{id?}"
    },
    "bg": {
      "kind": "color",
      "required": false,
      "promptOptional": true,
      "shape": "\"#rrggbb\" | \"brand\" | {stops: [\"#rrggbb\" (2–3 个)], angle?: number}",
      "swatches": [
        "#ffffff",
        "#f1f5f9",
        "#e0f2fe",
        "brand",
        "#1e293b",
        "#0f172a"
      ]
    }
  },
  "industries": {
    "required": [],
    "recommended": [
      "plumbing",
      "roofing",
      "landscaping",
      "cleaning",
      "construction"
    ],
    "discouraged": []
  },
  "prompt": {
    "group": "homepage",
    "order": 19,
    "headPrefix": "",
    "headSuffix": "a block head, a group of contact items (phone / email / address / hours / link) and a side column with the lead form and an optional map, with presets for form beside, details beside, stacked, map beside and map",
    "headExtra": null,
    "lines": [
      "@data",
      "items: only pick the kinds the site data really has (phone / email / address / hours); the value itself is read from the site data and shown under the title, so title and hint must NOT contain the phone number, email, address or opening hours (a copied value is removed) — title says what it is (\"Call us\"), hint says something else (\"Same-day reply\", \"Free parking\"); only kind link has an href (WhatsApp, booking page)",
      "if the business has no real street address, do not use the presets with a map (Map beside / Map)",
      "form picks the site's lead form (leave id empty for the default form); how much of it shows is the form knob",
      "bg is the background colour, top-level in data (not inside options)"
    ]
  },
  "toolbarGroups": [
    ["introPosition", "introAlign", "choice:introEyebrow.style"],
    ["sidePosition", "form", "formStyle"],
    ["itemsLayout", "itemStyle", "itemAlign", "itemIcon"],
    ["map"],
    ["color:bg"]
  ]
}
