{
  "type": "footer",
  "displayName": "Site Footer (Webpixels)",
  "category": "region",
  "region": true,
  "skin": "site-css",
  "roleDefault": "essential",
  "layout_intent": {
    "items": "none",
    "item_wrap": "allow",
    "headline": "none",
    "media": "none",
    "columns": "one"
  },
  "slots": {
    "logo": {
      "kind": "image",
      "required": false,
      "promptOptional": true
    },
    "brandName": {
      "kind": "text",
      "required": true,
      "promptOptional": false
    },
    "tagline": {
      "kind": "text",
      "required": false,
      "promptOptional": true
    },
    "nav": {
      "kind": "list",
      "required": false,
      "promptOptional": true,
      "shape": "[{label, href}]"
    },
    "columns": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{services: [{label, href}], areas: [{label, href}], contact: bool, keywordGroups: [{title, links: [{label, href}]}]}"
    },
    "contact": {
      "kind": "object",
      "required": true,
      "promptOptional": false,
      "shape": "{phone?, address?, hours?, email?}"
    },
    "social": {
      "kind": "list",
      "required": false,
      "promptOptional": true,
      "shape": "[{label, href, icon?}]"
    },
    "legal": {
      "kind": "list",
      "required": false,
      "promptOptional": true,
      "shape": "[{label, href}]"
    },
    "copyright": {
      "kind": "text",
      "required": false,
      "promptOptional": true
    },
    "cta": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{title, subtitle?, buttons: [{label, href, style: \"solid\" | \"outline\" | \"link\"}]}"
    },
    "form": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{id?}"
    },
    "bg": { "ref": "bg" },
    "options": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{preset?: string, layout, brand, cta, form}",
      "knobs": [
        { "name": "layout", "values": ["row", "stacked", "columns"] },
        { "name": "brand", "values": ["left", "right"] },
        { "name": "cta", "values": ["none", "centered", "boxed", "inline"] },
        { "name": "form", "values": ["none", "teaser", "full"] }
      ]
    }
  },
  "presets": [
    { "name": "slim-row", "shape": "slim-row", "knobs": { "layout": "row", "brand": "left", "cta": "none", "form": "none" } },
    { "name": "stacked", "shape": "stacked", "knobs": { "layout": "stacked", "brand": "left", "cta": "none", "form": "none" } },
    { "name": "columns", "shape": "columns", "knobs": { "layout": "columns", "brand": "left", "cta": "none", "form": "none" } },
    { "name": "cta-row", "shape": "cta-row", "knobs": { "layout": "row", "brand": "left", "cta": "centered", "form": "none" } },
    { "name": "cta-stacked", "shape": "cta-stacked", "knobs": { "layout": "stacked", "brand": "left", "cta": "inline", "form": "none" } },
    { "name": "cta-columns", "shape": "cta-columns", "knobs": { "layout": "columns", "brand": "left", "cta": "boxed", "form": "none" } }
  ],
  "industries": {
    "required": [],
    "recommended": [],
    "discouraged": []
  },
  "toolbarGroups": [
    ["layout", "brand", "cta"],
    ["color:bg"],
    ["form"]
  ]
}
