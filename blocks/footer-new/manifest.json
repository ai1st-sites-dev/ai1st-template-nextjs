{
  "type": "footer-new",
  "displayName": "Site Footer (Webpixels)",
  "category": "region",
  "region": true,
  "staging": true,
  "roleDefault": "essential",
  "layout_intent": {
    "items": "none",
    "item_wrap": "allow",
    "headline": "none",
    "media": "none",
    "columns": "one"
  },
  "slots": {
    "logo": {
      "kind": "image",
      "required": false,
      "promptOptional": true
    },
    "brandName": {
      "kind": "text",
      "required": true,
      "promptOptional": false
    },
    "tagline": {
      "kind": "text",
      "required": false,
      "promptOptional": true
    },
    "nav": {
      "kind": "list",
      "required": false,
      "promptOptional": true,
      "shape": "[{label, href}]"
    },
    "columns": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{services: [{label, href}], areas: [{label, href}], contact: bool}"
    },
    "contact": {
      "kind": "object",
      "required": true,
      "promptOptional": false,
      "shape": "{phone?, address?, hours?, email?}"
    },
    "social": {
      "kind": "list",
      "required": false,
      "promptOptional": true,
      "shape": "[{label, href, icon?}]"
    },
    "legal": {
      "kind": "list",
      "required": false,
      "promptOptional": true,
      "shape": "[{label, href}]"
    },
    "copyright": {
      "kind": "text",
      "required": false,
      "promptOptional": true
    },
    "cta": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{title, subtitle?, buttons: [{label, href, style: \"solid\" | \"outline\" | \"link\"}]}"
    },
    "form": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{style: \"inline\" | \"stacked\", fields: [\"name\" | \"phone\" | \"email\" | \"message\" | \"service\"], buttonText, successMessage, redirect?}",
      "choices": { "fields": ["name", "phone", "email", "message", "service"] }
    },
    "options": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{preset?: string, layout, cta, reverse: bool, dark: bool}",
      "knobs": [
        { "name": "layout", "values": ["row", "stacked", "columns"] },
        { "name": "cta", "values": ["none", "centered", "boxed", "inline"] }
      ]
    }
  },
  "presets": [
    { "name": "slim-row", "shape": "slim-row", "knobs": { "layout": "row", "cta": "none" } },
    { "name": "stacked", "shape": "stacked", "knobs": { "layout": "stacked", "cta": "none" } },
    { "name": "columns", "shape": "columns", "knobs": { "layout": "columns", "cta": "none" } },
    { "name": "cta-row", "shape": "cta-row", "knobs": { "layout": "row", "cta": "centered" } },
    { "name": "cta-stacked", "shape": "cta-stacked", "knobs": { "layout": "stacked", "cta": "inline" } },
    { "name": "cta-columns", "shape": "cta-columns", "knobs": { "layout": "columns", "cta": "boxed" } }
  ],
  "industries": {
    "required": [],
    "recommended": [],
    "discouraged": []
  }
}
