{
  "type": "faq",
  "displayName": "FAQ (Webpixels)",
  "category": "faq",
  "roleDefault": "essential",
  "skin": "site-css",
  "layout_intent": {
    "items": "stack",
    "item_wrap": "allow",
    "headline": "above",
    "cross": "none",
    "order": "dom",
    "item_parts": "stack",
    "inner": "many"
  },
  "presets": [
    {
      "name": "Accordion",
      "shape": "accordion",
      "knobs": {
        "introPosition": "top",
        "introAlign": "center",
        "itemsMode": "accordion",
        "itemsColumns": "1",
        "itemStyle": "divided",
        "itemToggle": "chevron"
      }
    },
    {
      "name": "Side intro",
      "shape": "side-intro",
      "knobs": {
        "introPosition": "left",
        "introAlign": "left",
        "itemsMode": "accordion",
        "itemsColumns": "1",
        "itemStyle": "divided",
        "itemToggle": "plus"
      }
    },
    {
      "name": "Cards",
      "shape": "cards",
      "knobs": {
        "introPosition": "top",
        "introAlign": "center",
        "itemsMode": "accordion",
        "itemsColumns": "2",
        "itemStyle": "card",
        "itemToggle": "chevron"
      }
    },
    {
      "name": "Open grid",
      "shape": "open-grid",
      "knobs": {
        "introPosition": "top",
        "introAlign": "left",
        "itemsMode": "open",
        "itemsColumns": "3",
        "itemStyle": "plain",
        "itemToggle": "chevron"
      }
    }
  ],
  "parts": [
    "help"
  ],
  "slots": {
    "options": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{introPosition, introAlign, itemsMode, itemsColumns, itemStyle, itemToggle}",
      "knobs": [
        {
          "name": "introPosition",
          "values": [
            "left",
            "right",
            "top",
            "bottom"
          ]
        },
        {
          "name": "introAlign",
          "values": [
            "left",
            "center",
            "right"
          ]
        },
        {
          "name": "itemsMode",
          "values": [
            "accordion",
            "open"
          ]
        },
        {
          "name": "itemsColumns",
          "values": [
            "1",
            "2",
            "3"
          ]
        },
        {
          "name": "itemStyle",
          "values": [
            "plain",
            "card",
            "divided"
          ],
          "default": "divided"
        },
        {
          "name": "itemToggle",
          "values": [
            "chevron",
            "plus"
          ]
        }
      ]
    },
    "introEyebrow": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{text, style: \"none\" | \"pill\" | \"outline\" | \"dash\" | \"plain\"}",
      "editLabel": {
        "text": "Eyebrow"
      },
      "choices": {
        "style": [
          "none",
          "pill",
          "outline",
          "dash",
          "plain"
        ]
      }
    },
    "headline": {
      "kind": "text",
      "required": true,
      "promptOptional": false,
      "editLabel": "Headline"
    },
    "body": {
      "kind": "text",
      "required": false,
      "promptOptional": true,
      "editLabel": "Text"
    },
    "help": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{headline, body, cta: {label, href, style: \"solid\" | \"outline\" | \"link\", icon?, arrow?, size?}}",
      "editLabel": {
        "headline": "Help title",
        "body": "Help text"
      }
    },
    "items": {
      "kind": "list",
      "required": true,
      "promptOptional": false,
      "minItems": 1,
      "maxItems": 12,
      "shape": "[{question, answer}]",
      "editLabel": {
        "question": "Question",
        "answer": "Answer"
      }
    },
    "bg": {
      "kind": "color",
      "required": false,
      "promptOptional": true,
      "shape": "\"#rrggbb\" | \"brand\" | {stops: [\"#rrggbb\" (2–3 个)], angle?: number}",
      "swatches": [
        "#ffffff",
        "#f1f5f9",
        "#e0f2fe",
        "brand",
        "#1e293b",
        "#0f172a"
      ]
    }
  },
  "industries": {
    "required": [],
    "recommended": [
      "insurance",
      "law",
      "dental",
      "roofing"
    ],
    "discouraged": []
  },
  "prompt": {
    "group": "homepage",
    "order": 12,
    "headPrefix": "",
    "headSuffix": "a block head (headline + text, optional help card) over 1–12 questions with answers, with presets for an accordion, a side intro, cards and an open grid",
    "headExtra": null,
    "lines": [
      "@data",
      "items: 4–8 is best, written from the site's own real information (how pricing works, how fast you get there, warranty, service area, how to book); never invent a policy the business does not have",
      "help is the \"still have a question?\" card next to the block head: point its cta at the phone number (tel:) or the contact page",
      "bg is the background colour, top-level in data (not inside options)"
    ]
  },
  "toolbarGroups": [
    ["introPosition", "introAlign", "choice:introEyebrow.style", "part:help"],
    ["itemsMode", "itemsColumns"],
    ["itemStyle", "itemToggle"],
    ["color:bg"]
  ],
  "itemsGrid": {
    "knob": "itemsColumns",
    "phone": 1,
    "tablet": 2,
    "grids": [
      {"container": ".fq-grid", "render": "flex", "item": ".fq-item", "gapVar": "--fq-gap"}
    ]
  }
}
