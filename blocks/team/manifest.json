{
  "type": "team",
  "displayName": "Team (Webpixels)",
  "category": "team",
  "roleDefault": "optional",
  "skin": "site-css",
  "layout_intent": {
    "items": "grid",
    "item_wrap": "allow",
    "headline": "above",
    "cross": "none",
    "order": "dom",
    "item_parts": "stack",
    "inner": "many"
  },
  "parts": [
    "join"
  ],
  "presets": [
    {
      "name": "Photo grid",
      "shape": "photo-grid",
      "knobs": {
        "introPosition": "top",
        "introAlign": "center",
        "membersColumns": "4",
        "memberPhoto": "top",
        "photoShape": "square",
        "memberStyle": "plain",
        "memberAlign": "left"
      }
    },
    {
      "name": "Cards",
      "shape": "cards",
      "knobs": {
        "introPosition": "top",
        "introAlign": "center",
        "membersColumns": "2",
        "memberPhoto": "top",
        "photoShape": "circle",
        "memberStyle": "card",
        "memberAlign": "center"
      }
    },
    {
      "name": "Side intro",
      "shape": "side-intro",
      "knobs": {
        "introPosition": "left",
        "introAlign": "left",
        "membersColumns": "2",
        "memberPhoto": "top",
        "photoShape": "square",
        "memberStyle": "plain",
        "memberAlign": "left"
      }
    },
    {
      "name": "List",
      "shape": "list",
      "knobs": {
        "introPosition": "top",
        "introAlign": "left",
        "membersColumns": "2",
        "memberPhoto": "left",
        "photoShape": "circle",
        "memberStyle": "plain",
        "memberAlign": "left"
      }
    },
    {
      "name": "Hiring",
      "shape": "hiring",
      "knobs": {
        "introPosition": "top",
        "introAlign": "center",
        "membersColumns": "3",
        "memberPhoto": "top",
        "photoShape": "circle",
        "memberStyle": "card",
        "memberAlign": "left"
      },
      "parts": [
        "join"
      ]
    }
  ],
  "slots": {
    "options": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{introPosition, introAlign, membersColumns, memberPhoto, photoShape, memberStyle, memberAlign}",
      "knobs": [
        {
          "name": "introPosition",
          "values": [
            "left",
            "right",
            "top",
            "bottom"
          ]
        },
        {
          "name": "introAlign",
          "values": [
            "left",
            "center",
            "right"
          ]
        },
        {
          "name": "membersColumns",
          "values": [
            "2",
            "3",
            "4"
          ]
        },
        {
          "name": "memberPhoto",
          "values": [
            "left",
            "top"
          ],
          "default": "top"
        },
        {
          "name": "photoShape",
          "values": [
            "square",
            "circle"
          ]
        },
        {
          "name": "memberStyle",
          "values": [
            "plain",
            "card"
          ]
        },
        {
          "name": "memberAlign",
          "values": [
            "left",
            "center"
          ]
        }
      ]
    },
    "introEyebrow": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{text, style: \"none\" | \"pill\" | \"outline\" | \"dash\" | \"plain\"}",
      "editLabel": {
        "text": "Eyebrow"
      },
      "choices": {
        "style": [
          "none",
          "pill",
          "outline",
          "dash",
          "plain"
        ]
      }
    },
    "headline": {
      "kind": "text",
      "required": false,
      "promptOptional": false,
      "editLabel": "Headline"
    },
    "body": {
      "kind": "text",
      "required": false,
      "promptOptional": true,
      "editLabel": "Text"
    },
    "members": {
      "kind": "list",
      "required": true,
      "promptOptional": false,
      "minItems": 1,
      "maxItems": 12,
      "generateImages": false,
      "shape": "[{name, role, photo?: {imageUrl, alt}, bio?, links?: [{icon, href}]}]",
      "editLabel": {
        "name": "Name",
        "role": "Role",
        "bio": "Bio"
      }
    },
    "join": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{title, body, cta: {label, href, style?: \"solid\" | \"outline\" | \"link\", icon?, arrow?}}",
      "editLabel": {
        "title": "Title",
        "body": "Text"
      },
      "demo": {
        "title": "Join our team",
        "body": "We are hiring. Tell us a little about yourself and we will be in touch.",
        "cta": {
          "label": "See open roles",
          "href": "/contact",
          "style": "outline"
        }
      }
    },
    "bg": {
      "kind": "color",
      "required": false,
      "promptOptional": true,
      "shape": "\"#rrggbb\" | \"brand\" | {stops: [\"#rrggbb\" (2–3 个)], angle?: number}",
      "swatches": [
        "#ffffff",
        "#f1f5f9",
        "#e0f2fe",
        "brand",
        "#1e293b",
        "#0f172a"
      ]
    }
  },
  "industries": {
    "required": [],
    "recommended": [
      "dental",
      "law",
      "medical",
      "salon"
    ],
    "discouraged": []
  },
  "prompt": {
    "group": "homepage",
    "order": 15,
    "headPrefix": "",
    "headSuffix": "a block head (headline + text) over the real people on the team (1–12 members: name, role, optional photo, bio and links), with an optional hiring card",
    "headExtra": null,
    "lines": [
      "@data",
      "members: 1–12 items, each {name, role, photo?, bio?, links?}; only real people named on the site — if you cannot find any, leave the block out rather than inventing staff",
      "photo only when the owner uploaded a photo of that person — otherwise leave photo out (never a stock or generated face); links[].icon is a Bootstrap Icons name (\"linkedin\", \"envelope\", \"telephone\") and href is that person's real link",
      "join {title, body, cta} only when the site says it is hiring; bg is the background colour, top-level in data (not inside options)"
    ]
  },
  "toolbarGroups": [
    ["introPosition", "introAlign", "choice:introEyebrow.style", "part:join"],
    ["membersColumns"],
    ["memberPhoto", "photoShape", "memberStyle", "memberAlign"],
    ["color:bg"]
  ],
  "itemsGrid": {
    "knob": "membersColumns",
    "phone": 1,
    "tablet": 2,
    "grids": [
      {"container": ".tm-grid", "render": "flex", "item": ".tm-member", "gapVar": "--tm-gap"}
    ]
  }
}
