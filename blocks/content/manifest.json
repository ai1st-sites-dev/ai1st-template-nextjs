{
  "type": "content",
  "displayName": "Content",
  "category": "text",
  "roleDefault": "optional",
  "skin": "site-css",
  "layout_intent": {
    "items": "none",
    "item_wrap": "allow",
    "headline": "above",
    "cross": "none",
    "order": "dom",
    "item_parts": "none",
    "inner": "one"
  },
  "presets": [
    {
      "name": "Article",
      "shape": "article",
      "knobs": {
        "headlinePosition": "top",
        "textAlign": "left",
        "textStyle": "article",
        "image": "none",
        "frame": "none"
      }
    },
    {
      "name": "Title left",
      "shape": "title-left",
      "knobs": {
        "headlinePosition": "left",
        "textAlign": "left",
        "textStyle": "article",
        "image": "none",
        "frame": "none"
      }
    },
    {
      "name": "Image right",
      "shape": "image-right",
      "knobs": {
        "headlinePosition": "top",
        "textAlign": "left",
        "textStyle": "article",
        "image": "right",
        "frame": "none"
      }
    },
    {
      "name": "Statement",
      "shape": "statement",
      "knobs": {
        "headlinePosition": "top",
        "textAlign": "left",
        "textStyle": "statement",
        "image": "none",
        "frame": "card"
      }
    }
  ],
  "slots": {
    "options": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{headlinePosition, textAlign, textStyle, image, frame}",
      "knobs": [
        {
          "name": "headlinePosition",
          "values": [
            "left",
            "top"
          ],
          "default": "top"
        },
        {
          "name": "textAlign",
          "values": [
            "left",
            "center"
          ]
        },
        {
          "name": "textStyle",
          "values": [
            "article",
            "statement"
          ]
        },
        {
          "name": "image",
          "values": [
            "none",
            "left",
            "right",
            "top",
            "bottom"
          ]
        },
        {
          "name": "frame",
          "values": [
            "none",
            "card"
          ]
        }
      ]
    },
    "introEyebrow": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{text, style: \"none\" | \"pill\" | \"outline\" | \"dash\" | \"plain\"}",
      "editLabel": {
        "text": "Eyebrow"
      },
      "choices": {
        "style": [
          "none",
          "pill",
          "outline",
          "dash",
          "plain"
        ]
      }
    },
    "headline": {
      "kind": "text",
      "required": false,
      "promptOptional": true,
      "editLabel": "Headline"
    },
    "body": {
      "kind": "richtext",
      "required": true,
      "promptOptional": false,
      "editLabel": "Text"
    },
    "ctas": {
      "kind": "list",
      "required": false,
      "promptOptional": true,
      "max": 2,
      "shape": "[{label, href, style: \"solid\" | \"outline\" | \"link\", icon?, arrow?, size?}]",
      "editLabel": {
        "label": "Button text"
      }
    },
    "image": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{imageUrl, alt}",
      "editLabel": "Image"
    },
    "bg": { "ref": "bg" }
  },
  "industries": {
    "required": [],
    "recommended": [],
    "discouraged": []
  },
  "prompt": {
    "group": "homepage",
    "order": 6,
    "headPrefix": "",
    "headSuffix": "a text section: optional eyebrow + headline, a body of paragraphs / lists, up to 2 buttons, optionally one picture — for the homepage and for the main text of inner pages",
    "headExtra": null,
    "lines": [
      "@data",
      "body is written in a small markdown subset — blank line between paragraphs, \"- \" for a bullet list, \"1. \" for a numbered list, **bold**, [text](/link) — never HTML",
      "use textStyle article for the text of a service page or the About page; use statement for a one- or two-sentence promise, and then the body is only those one or two sentences",
      "numbers and statistics go in a milestones block, not here; image only shows when options.image is not \"none\"; bg is the background colour, top-level in data (not inside options)"
    ]
  },
  "toolbarGroups": [
    ["headlinePosition", "textAlign", "choice:introEyebrow.style"],
    ["textStyle", "count:ctas"],
    ["image"],
    ["frame"],
    ["color:bg"]
  ],
  "mediaLayout": [
    {"knob": "image", "row": ".co-outer", "text": ".co-frame", "media": ".co-img"}
  ]
}
