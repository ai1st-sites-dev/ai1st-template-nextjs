  ],
  "slots": {
    "options": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{introPosition, introAlign, introImage, itemsLayout, itemsColumns, itemsImage, itemStyle, itemAlign, itemIcon, itemImage, itemConnector}",
      "knobs": [
        {
          "name": "introPosition",
          "values": [
            "left",
            "right",
            "top",
            "bottom"
          ]
        },
        {
          "name": "introAlign",
          "values": [
            "left",
            "center",
            "right"
          ]
        },
        {
          "name": "introImage",
          "values": [
            "none",
            "left",
            "right",
            "top",
            "bottom"
          ]
        },
        {
          "name": "itemsLayout",
          "values": [
            "grid",
            "list"
          ]
        },
        {
          "name": "itemsColumns",
          "values": [
            "2",
            "3",
            "4"
          ]
        },
        {
          "name": "itemsImage",
          "values": [
            "none",
            "left",
            "right"
          ]
        },
        {
          "name": "itemStyle",
          "values": [
            "plain",
            "card"
          ]
        },
        {
          "name": "itemAlign",
          "values": [
            "left",
            "center",
            "right"
          ]
        },
        {
          "name": "itemIcon",
          "values": [
            "top",
            "left",
            "right",
            "none"
          ]
        },
        {
          "name": "itemImage",
          "values": [
            "none",
            "left",
            "right",
            "top",
            "bottom",
            "background"
          ]
        },
        {
          "name": "itemConnector",
          "values": [
            "none",
            "line"
          ]
        }
      ]
    },
    "introEyebrow": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{text, style: \"none\" | \"pill\" | \"outline\" | \"dash\" | \"plain\"}",
      "editLabel": {
        "text": "Eyebrow"
      },
      "choices": {
        "style": [
          "none",
          "pill",
          "outline",
          "dash",
          "plain"
        ]
      }
    },
    "headline": {
      "kind": "text",
      "required": true,
      "promptOptional": false,
      "editLabel": "Headline"
    },
    "body": {
      "kind": "text",
      "required": false,
      "promptOptional": true,
      "editLabel": "Text"
    },
    "introCtas": {
      "kind": "list",
      "required": false,
      "promptOptional": true,
      "max": 2,
      "shape": "[{label, href, style: \"solid\" | \"outline\" | \"link\", icon?, arrow?, size?}]",
      "editLabel": {
        "label": "Button text"
      }
    },
    "introImage": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{imageUrl, alt}"
    },
    "itemsImage": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{imageUrl, alt}"
    },
    "items": {
      "kind": "list",
      "required": true,
      "promptOptional": false,
      "minItems": 1,
      "maxItems": 8,
      "shape": "[{number?, icon?, image?: {imageUrl, alt}, title, text, link?: {label, href, style?: \"solid\" | \"outline\" | \"link\", icon?, arrow?}}]",
      "editLabel": {
        "title": "Title",
        "text": "Text"
      }
    },
    "bg": {
      "kind": "color",
      "required": false,
      "promptOptional": true,
      "shape": "\"#rrggbb\" | \"brand\" | {stops: [\"#rrggbb\" (2–3 个)], angle?: number}",
      "swatches": [
        "#ffffff",
        "#f1f5f9",
        "#e0f2fe",
        "brand",
        "#1e293b",
        "#0f172a"
      ]
    }
  },
  "industries": {
    "required": [],
    "recommended": [],
    "discouraged": []
  },
  "prompt": {
    "group": "homepage",
    "order": 5,
    "headPrefix": "",
    "headSuffix": "a block head (headline + text) over a set of 1–8 items, with presets for grids, cards, lists and photo cards",
    "headExtra": null,
    "lines": [
      "@data",
      "fill items from the site's own services list, 1–8 items (one per service); icon is a Bootstrap Icons name (\"tools\", \"disc\", \"snow\")",
      "for step-by-step content (how it works, our process) give every item a number (\"01\", \"02\" …) and set options.itemConnector to \"line\"",
      "images only show when the matching option is on: introImage needs options.introImage, itemsImage needs options.itemsImage, items[].image needs options.itemImage; bg is the background colour, top-level in data (not inside options)"
    ]
  }
}
