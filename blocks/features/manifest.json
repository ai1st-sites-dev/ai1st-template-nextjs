{
  "type": "features",
  "displayName": "Features (Webpixels)",
  "category": "features",
  "roleDefault": "essential",
  "skin": "site-css",
  "layout_intent": {
    "items": "grid",
    "item_wrap": "allow",
    "headline": "above",
    "cross": "none",
    "order": "dom",
    "item_parts": "stack",
    "inner": "many"
  },
  "presets": [
    {
      "name": "Grid",
      "shape": "grid",
      "knobs": {
        "introPosition": "top",
        "introAlign": "left",
        "introImage": "none",
        "itemsLayout": "grid",
        "itemsColumns": "3",
        "itemsImage": "none",
        "itemStyle": "plain",
        "itemAlign": "left",
        "itemIcon": "top",
        "itemImage": "none",
        "itemConnector": "none"
      }
    },
    {
      "name": "Cards",
      "shape": "cards",
      "knobs": {
        "introPosition": "top",
        "introAlign": "center",
        "introImage": "none",
        "itemsLayout": "grid",
        "itemsColumns": "3",
        "itemsImage": "none",
        "itemStyle": "card",
        "itemAlign": "left",
        "itemIcon": "top",
        "itemImage": "none",
        "itemConnector": "none"
      }
    },
    {
      "name": "Side intro",
      "shape": "side-intro",
      "knobs": {
        "introPosition": "left",
        "introAlign": "left",
        "introImage": "none",
        "itemsLayout": "grid",
        "itemsColumns": "2",
        "itemsImage": "none",
        "itemStyle": "card",
        "itemAlign": "left",
        "itemIcon": "top",
        "itemImage": "none",
        "itemConnector": "none"
      }
    },
    {
      "name": "Intro photo",
      "shape": "intro-photo",
      "knobs": {
        "introPosition": "top",
        "introAlign": "left",
        "introImage": "right",
        "itemsLayout": "grid",
        "itemsColumns": "3",
        "itemsImage": "none",
        "itemStyle": "card",
        "itemAlign": "left",
        "itemIcon": "top",
        "itemImage": "none",
        "itemConnector": "none"
      }
    },
    {
      "name": "Photo list",
      "shape": "photo-list",
      "knobs": {
        "introPosition": "top",
        "introAlign": "center",
        "introImage": "none",
        "itemsLayout": "list",
        "itemsColumns": "3",
        "itemsImage": "left",
        "itemStyle": "plain",
        "itemAlign": "left",
        "itemIcon": "left",
        "itemImage": "none",
        "itemConnector": "none"
      }
    },
    {
      "name": "Photo cards",
      "shape": "photo-cards",
      "knobs": {
        "introPosition": "top",
        "introAlign": "center",
        "introImage": "none",
        "itemsLayout": "grid",
        "itemsColumns": "3",
        "itemsImage": "none",
        "itemStyle": "card",
        "itemAlign": "left",
        "itemIcon": "none",
        "itemImage": "top",
        "itemConnector": "none"
      }
    },
    {
      "name": "Cover cards",
      "shape": "cover-cards",
      "knobs": {
        "introPosition": "top",
        "introAlign": "center",
        "introImage": "none",
        "itemsLayout": "grid",
        "itemsColumns": "3",
        "itemsImage": "none",
        "itemStyle": "card",
        "itemAlign": "left",
        "itemIcon": "none",
        "itemImage": "background",
        "itemConnector": "none"
      }
    },
    {
      "name": "Steps",
      "shape": "steps",
      "knobs": {
        "introPosition": "top",
        "introAlign": "left",
        "introImage": "none",
        "itemsLayout": "grid",
        "itemsColumns": "3",
        "itemsImage": "none",
        "itemStyle": "plain",
        "itemAlign": "left",
        "itemIcon": "none",
        "itemImage": "none",
        "itemConnector": "line"
      }
    }
  ],
  "slots": {
    "options": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{introPosition, introAlign, introImage, itemsLayout, itemsColumns, itemsImage, itemStyle, itemAlign, itemIcon, itemImage, itemConnector}",
      "knobs": [
        {
          "name": "introPosition",
          "values": [
            "left",
            "right",
            "top",
            "bottom"
          ]
        },
        {
          "name": "introAlign",
          "values": [
            "left",
            "center",
            "right"
          ]
        },
        {
          "name": "introImage",
          "values": [
            "none",
            "left",
            "right",
            "top",
            "bottom"
          ]
        },
        {
          "name": "itemsLayout",
          "values": [
            "grid",
            "list"
          ]
        },
        {
          "name": "itemsColumns",
          "values": [
            "2",
            "3",
            "4"
          ]
        },
        {
          "name": "itemsImage",
          "values": [
            "none",
            "left",
            "right"
          ]
        },
        {
          "name": "itemStyle",
          "values": [
            "plain",
            "card"
          ]
        },
        {
          "name": "itemAlign",
          "values": [
            "left",
            "center",
            "right"
          ]
        },
        {
          "name": "itemIcon",
          "values": [
            "none",
            "left",
            "right",
            "top"
          ],
          "default": "top"
        },
        {
          "name": "itemImage",
          "values": [
            "none",
            "left",
            "right",
            "top",
            "bottom",
            "background"
          ]
        },
        {
          "name": "itemConnector",
          "values": [
            "none",
            "line"
          ]
        }
      ]
    },
    "introEyebrow": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{text, style: \"none\" | \"pill\" | \"outline\" | \"dash\" | \"plain\"}",
      "editLabel": {
        "text": "Eyebrow"
      },
      "choices": {
        "style": [
          "none",
          "pill",
          "outline",
          "dash",
          "plain"
        ]
      }
    },
    "headline": {
      "kind": "text",
      "required": true,
      "promptOptional": false,
      "editLabel": "Headline"
    },
    "body": {
      "kind": "text",
      "required": false,
      "promptOptional": true,
      "editLabel": "Text"
    },
    "introCtas": {
      "kind": "list",
      "required": false,
      "promptOptional": true,
      "max": 2,
      "shape": "[{label, href, style: \"solid\" | \"outline\" | \"link\", icon?, arrow?, size?}]",
      "editLabel": {
        "label": "Button text"
      }
    },
    "introImage": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{imageUrl, alt}"
    },
    "itemsImage": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{imageUrl, alt}"
    },
    "items": {
      "kind": "list",
      "required": true,
      "promptOptional": false,
      "minItems": 1,
      "maxItems": 8,
      "shape": "[{number?, icon?, image?: {imageUrl, alt}, title, text, bullets?: [string], link?: {label, href, style?: \"solid\" | \"outline\" | \"link\", icon?, arrow?}}]",
      "editLabel": {
        "title": "Title",
        "text": "Text"
      }
    },
    "bg": { "ref": "bg" }
  },
  "industries": {
    "required": [],
    "recommended": [],
    "discouraged": []
  },
  "prompt": {
    "group": "homepage",
    "order": 5,
    "headPrefix": "",
    "headSuffix": "a block head (headline + text) over a set of 1–8 items, with presets for grids, cards, lists and photo cards",
    "headExtra": null,
    "lines": [
      "@data",
      "to show this website's services write items: {\"source\": \"services\"} — do not copy the services in; on a service page, to list the pages under that service write items: {\"source\": \"pages\", \"under\": \"<this service's slug>\"}; write items by hand (1–8) only for content that lives on this page alone, such as selling points or process steps; icon is a Bootstrap Icons name (\"tools\", \"disc\", \"snow\")",
      "an item can carry bullets: a short list (1–4) of plain phrases under its text, such as what is included; leave bullets out when the text already says it",
      "for step-by-step content (how it works, our process) give every item a number (\"01\", \"02\" …) and set options.itemConnector to \"line\"",
      "images only show when the matching option is on: introImage needs options.introImage, itemsImage needs options.itemsImage, items[].image needs options.itemImage; bg is the background colour, top-level in data (not inside options)"
    ]
  },
  "toolbarGroups": [
    ["introPosition", "introAlign", "choice:introEyebrow.style", "count:introCtas", "introImage"],
    ["itemsLayout", "itemsColumns", "itemsImage"],
    ["itemStyle", "itemAlign", "itemIcon", "itemImage", "itemConnector"],
    ["color:bg"]
  ],
  "itemsGrid": {
    "knob": "itemsColumns",
    "phone": 1,
    "tablet": 2,
    "grids": [
      {"container": ".fx-grid", "render": "percent", "item": ".fx-item"}
    ]
  },
  "introLayout": {
    "text": ".fx-intro-text",
    "frame": ".fx-frame",
    "introCol": ".fx-introcol",
    "mainCol": ".fx-itemscol",
    "side": "33.3333%",
    "follow": [
      {"target": ".fx-ctas", "by": "justify"}
    ]
  },
  "mediaLayout": [
    {"knob": "introImage", "row": ".fx-intro", "text": ".fx-intro-text", "media": ".fx-intro-img"},
    {"knob": "itemsImage", "row": ".fx-itemsrow", "text": ".fx-itemsgrid", "media": ".fx-itemsimg"}
  ]
}
