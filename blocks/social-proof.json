{
  "type": "social-proof",
  "displayName": "Social Proof",
  "category": "testimonial",
  "roleDefault": "optional",
  "shapes": [
    {
      "name": "two-up",
      "needs": [],
      "layout_intent": {
        "items": "grid",
        "item_wrap": "allow",
        "headline": "above",
        "media": "below",
        "columns": "two"
      }
    },
    {
      "name": "three-up",
      "needs": [],
      "layout_intent": {
        "items": "grid",
        "item_wrap": "allow",
        "headline": "above",
        "media": "below",
        "columns": "three"
      }
    },
    {
      "name": "heading-above-band",
      "needs": ["stats"],
      "layout_intent": {
        "items": "grid",
        "item_wrap": "allow",
        "headline": "above",
        "media": "below",
        "columns": "four"
      }
    },
    {
      "name": "media-side-list",
      "needs": ["stats", "imageUrl"],
      "layout_intent": {
        "items": "stack",
        "item_wrap": "allow",
        "headline": "above",
        "media": "side",
        "columns": "two"
      }
    },
    {
      "name": "row-band",
      "needs": ["stats"],
      "layout_intent": {
        "items": "row",
        "item_wrap": "allow",
        "headline": "above",
        "media": "below",
        "columns": "many"
      }
    }
  ],
  "slots": {
    "headline": {
      "kind": "text",
      "required": true,
      "promptOptional": false,
      "editLabel": "Headline"
    },
    "overallRating": {
      "kind": "text",
      "required": true,
      "promptOptional": false,
      "shape": "\"4.9\"",
      "editLabel": "Overall rating"
    },
    "totalReviews": {
      "kind": "text",
      "required": true,
      "promptOptional": false,
      "shape": "\"500+\"",
      "editLabel": "Total reviews"
    },
    "platforms": {
      "kind": "list",
      "required": false,
      "promptOptional": true,
      "shape": "[{name, rating, reviews}]",
      "editLabel": {
        "name": "Platform name"
      }
    },
    "badges": {
      "kind": "list",
      "required": false,
      "promptOptional": true,
      "shape": "[string]",
      "editLabel": "Badge"
    },
    "featuredQuote": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{text, author}",
      "editLabel": {
        "text": "Quote",
        "author": "Quote author"
      }
    },
    "stats": {
      "kind": "list",
      "required": false,
      "promptOptional": true,
      "shape": "[{value:\"500+\", label:\"Projects Completed\"}]",
      "editLabel": {
        "value": "Stat number",
        "label": "Stat label"
      }
    },
    "imageUrl": {
      "kind": "image",
      "required": false,
      "promptOptional": true,
      "shape": "string"
    }
  },
  "variants": {
    "rating-bar": "star bars with distribution",
    "badges": "trust badges grid",
    "review-platforms": "platform ratings row",
    "highlight": "dark bg, big rating + quote"
  },
  "variantKey": "variants",
  "industries": {
    "required": [],
    "recommended": [],
    "discouraged": []
  },
  "prompt": {
    "group": "homepage",
    "order": 10,
    "headPrefix": "",
    "headSuffix": "",
    "headExtra": null,
    "lines": [
      "@data"
    ]
  }
}
