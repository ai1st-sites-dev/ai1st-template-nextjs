{
  "type": "hero",
  "displayName": "Hero",
  "category": "banner",
  "roleDefault": "lead",
  "skin": "site-css",
  "layout_intent": {
    "items": "none",
    "item_wrap": "allow",
    "headline": "none",
    "cross": "none",
    "order": "dom",
    "item_parts": "none",
    "inner": "one"
  },
  "parts": ["proof", "stats", "logos", "band"],
  "presets": [
    { "name": "Split", "shape": "split", "knobs": { "textAlign": "left", "image": "left", "form": "none" } },
    { "name": "Centered", "shape": "centered", "knobs": { "textAlign": "center", "image": "bottom", "form": "none" } },
    { "name": "Cover", "shape": "cover", "knobs": { "textAlign": "left", "image": "background", "form": "none" } },
    { "name": "Lead form", "shape": "lead-form", "knobs": { "textAlign": "left", "image": "left", "form": "full" } },
    { "name": "Text only", "shape": "text-only", "knobs": { "textAlign": "left", "image": "none", "form": "none" } }
  ],
  "slots": {
    "options": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{textAlign, image, form}",
      "knobs": [
        { "name": "textAlign", "values": ["left", "center", "right"] },
        { "name": "image", "values": ["none", "left", "right", "top", "bottom", "background"] },
        { "name": "form", "values": ["none", "teaser", "full"] }
      ]
    },
    "bg": { "ref": "bg" },
    "proof": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{avatars: [{imageUrl}], rating, text}",
      "editLabel": {
        "text": "Review line"
      }
    },
    "stats": {
      "kind": "list",
      "required": false,
      "promptOptional": true,
      "shape": "[{value, label}]",
      "editLabel": {
        "value": "Number",
        "label": "What it counts"
      }
    },
    "logos": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{caption, items: [{imageUrl, alt}]}",
      "editLabel": {
        "caption": "Logos caption"
      }
    },
    "band": {
      "kind": "list",
      "required": false,
      "promptOptional": true,
      "shape": "[{imageUrl, alt?}]",
      "editItems": true
    },
    "eyebrow": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{text, style: \"pill\" | \"outline\" | \"dash\" | \"plain\" | \"none\"}",
      "editLabel": {
        "text": "Eyebrow"
      },
      "choices": {
        "style": ["none", "pill", "outline", "dash", "plain"]
      },
      "choiceDefaults": {
        "style": "pill"
      }
    },
    "headline": {
      "kind": "text",
      "required": true,
      "promptOptional": false,
      "editLabel": "Headline"
    },
    "subheadline": {
      "kind": "text",
      "required": false,
      "promptOptional": true,
      "editLabel": "Subheading"
    },
    "ctas": {
      "kind": "list",
      "required": false,
      "promptOptional": true,
      "shape": "[{label, href, style: \"solid\" | \"outline\" | \"link\", icon?, arrow?, size?}]",
      "editLabel": {
        "label": "Button text"
      }
    },
    "image": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{imageUrl, alt}",
      "editLabel": "Image"
    },
    "form": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{id?}"
    }
  },
  "industries": {
    "required": [],
    "recommended": [],
    "discouraged": []
  },
  "prompt": {
    "group": "homepage",
    "order": 3,
    "headPrefix": "",
    "headSuffix": "the first-screen banner with presets (use it or hero, never both on one page)",
    "headExtra": null,
    "lines": [
      "@data",
      "the form only shows when options.form is \"teaser\" (one field + button) or \"full\" (the whole form) — with a form the ctas are not shown; bg is the background colour, top-level in data (not inside options)"
    ]
  },
  "toolbarGroups": [
    ["textAlign", "image", "form"],
    ["color:bg"],
    ["part:proof", "part:stats", "part:logos", "part:band"],
    ["choice:eyebrow.style"]
  ],
  "mediaLayout": [
    {"knob": "image", "row": ".hro-row", "text": ".hro-textcol", "media": ".hro-side"}
  ]
}
