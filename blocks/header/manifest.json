{
  "type": "header",
  "displayName": "Site Header",
  "category": "region",
  "region": true,
  "skin": "site-css",
  "roleDefault": "essential",
  "layout_intent": {
    "items": "none",
    "item_wrap": "allow",
    "headline": "none",
    "media": "none",
    "columns": "one"
  },
  "slots": {
    "logo": {
      "kind": "image",
      "required": false,
      "promptOptional": true
    },
    "brandName": {
      "kind": "text",
      "required": true,
      "promptOptional": false
    },
    "nav": {
      "kind": "list",
      "required": true,
      "promptOptional": false,
      "shape": "[{label, href, icon?, show: \"text\" | \"icon\" | \"both\"}]"
    },
    "buttons": {
      "kind": "list",
      "required": false,
      "promptOptional": true,
      "maxItems": 3,
      "shape": "[{label, href, style: \"solid\" | \"outline\" | \"link\"}]"
    },
    "topbar": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{message?: {text, href?, label?}, contact: [{icon, text, href?}], links: [{label, href}], social: [{label, href, icon}]}"
    },
    "bg": { "ref": "bg" },
    "options": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{preset?: string, logo, menu, topbar: bool, icons: bool, sticky: bool}",
      "knobs": [
        { "name": "logo", "values": ["left", "center", "right"] },
        { "name": "menu", "values": ["beside", "center", "left", "below"] }
      ]
    }
  },
  "presets": [
    { "name": "logo-left", "shape": "logo-left", "knobs": { "logo": "left", "menu": "beside" }, "options": { "topbar": false } },
    { "name": "menu-center", "shape": "menu-center", "knobs": { "logo": "left", "menu": "center" }, "options": { "topbar": false } },
    { "name": "logo-center", "shape": "logo-center", "knobs": { "logo": "center", "menu": "left" }, "options": { "topbar": false } },
    { "name": "topbar", "shape": "topbar", "knobs": { "logo": "left", "menu": "beside" }, "options": { "topbar": true } },
    { "name": "stacked", "shape": "stacked", "knobs": { "logo": "center", "menu": "below" }, "options": { "topbar": false } },
    { "name": "topbar-stacked", "shape": "topbar-stacked", "knobs": { "logo": "center", "menu": "below" }, "options": { "topbar": true } }
  ],
  "knobCoupling": ["logo", "menu"],
  "industries": {
    "required": [],
    "recommended": [],
    "discouraged": []
  },
  "toolbarGroups": [
    ["logo", "menu", "bool:topbar", "bool:sticky"],
    ["color:bg"],
    ["bool:icons"]
  ]
}
