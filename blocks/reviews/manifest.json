{
  "type": "reviews",
  "displayName": "Reviews (Webpixels)",
  "category": "testimonial",
  "roleDefault": "optional",
  "skin": "site-css",
  "layout_intent": {
    "items": "grid",
    "item_wrap": "allow",
    "headline": "above",
    "cross": "none",
    "order": "dom",
    "item_parts": "stack",
    "inner": "many"
  },
  "presets": [
    {
      "name": "Cards",
      "shape": "cards",
      "knobs": {
        "introPosition": "top",
        "introAlign": "center",
        "total": "none",
        "itemsLayout": "grid",
        "itemStyle": "card",
        "itemAlign": "center"
      }
    },
    {
      "name": "Side score",
      "shape": "side-score",
      "knobs": {
        "introPosition": "left",
        "introAlign": "left",
        "total": "show",
        "itemsLayout": "grid",
        "itemStyle": "card",
        "itemAlign": "center"
      }
    },
    {
      "name": "Strip",
      "shape": "strip",
      "knobs": {
        "introPosition": "top",
        "introAlign": "center",
        "total": "none",
        "itemsLayout": "row",
        "itemStyle": "card",
        "itemAlign": "center"
      }
    }
  ],
  "slots": {
    "options": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{introPosition, introAlign, total, itemsLayout, itemStyle, itemAlign}",
      "knobs": [
        {
          "name": "introPosition",
          "values": [
            "left",
            "right",
            "top",
            "bottom"
          ]
        },
        {
          "name": "introAlign",
          "values": [
            "left",
            "center",
            "right"
          ]
        },
        {
          "name": "total",
          "values": [
            "none",
            "show"
          ]
        },
        {
          "name": "itemsLayout",
          "values": [
            "grid",
            "row"
          ]
        },
        {
          "name": "itemStyle",
          "values": [
            "plain",
            "card"
          ]
        },
        {
          "name": "itemAlign",
          "values": [
            "left",
            "center",
            "right"
          ]
        }
      ]
    },
    "introEyebrow": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{text, style: \"none\" | \"pill\" | \"outline\" | \"dash\" | \"plain\"}",
      "editLabel": {
        "text": "Eyebrow"
      },
      "choices": {
        "style": [
          "none",
          "pill",
          "outline",
          "dash",
          "plain"
        ]
      }
    },
    "headline": {
      "kind": "text",
      "required": false,
      "promptOptional": true,
      "editLabel": "Headline"
    },
    "body": {
      "kind": "text",
      "required": false,
      "promptOptional": true,
      "editLabel": "Text"
    },
    "platforms": {
      "kind": "list",
      "required": true,
      "promptOptional": false,
      "minItems": 1,
      "maxItems": 4,
      "ranges": {
        "rating": [
          0,
          5,
          1
        ],
        "count": [
          1,
          null
        ]
      },
      "shape": "[{source, rating: 0–5, count, href?, logoUrl?}]",
      "editLabel": {
        "source": "Review site",
        "rating": "Rating",
        "count": "Number of reviews"
      }
    },
    "bg": {
      "kind": "color",
      "required": false,
      "promptOptional": true,
      "shape": "\"#rrggbb\" | \"brand\" | {stops: [\"#rrggbb\" (2–3 个)], angle?: number}",
      "swatches": [
        "#ffffff",
        "#f1f5f9",
        "#e0f2fe",
        "brand",
        "#1e293b",
        "#0f172a"
      ]
    }
  },
  "industries": {
    "required": [],
    "recommended": [],
    "discouraged": []
  },
  "prompt": {
    "group": "homepage",
    "order": 10,
    "headPrefix": "",
    "headSuffix": "a block head (headline + text, optional overall score the block works out itself) over 1–4 review-platform ratings (logo · score · stars · number of reviews), as cards or a compact strip",
    "headExtra": null,
    "lines": [
      "@data",
      "platforms: 1–4, each {source, rating, count, href?, logoUrl?} — source is the platform (\"Google\", \"Yelp\", \"HomeStars\"), rating 0–5 with one decimal, count the number of reviews there; write href when there is a link to the business's page on that platform",
      "logoUrl only when the owner uploaded that platform's logo (Google / Yelp / Facebook get a built-in icon automatically)",
      "only real numbers the owner gave or the site states — if you cannot find them, leave this block out; never write the overall score, the block works it out from the platforms",
      "review quotes go in testimonials (its summary can show a platform rating too) — put platform ratings in only one place on a page; bg is the background colour, top-level in data (not inside options)"
    ]
  },
  "toolbarGroups": [
    ["introPosition", "introAlign", "total", "choice:introEyebrow.style"],
    ["itemsLayout", "itemStyle", "itemAlign"],
    ["color:bg"]
  ]
}
