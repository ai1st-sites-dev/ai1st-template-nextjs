{
  "type": "pricing",
  "displayName": "Pricing (Webpixels)",
  "category": "pricing",
  "roleDefault": "optional",
  "skin": "site-css",
  "layout_intent": {
    "items": "row",
    "item_wrap": "allow",
    "headline": "above",
    "cross": "none",
    "order": "dom",
    "item_parts": "stack",
    "inner": "many"
  },
  "parts": [
    "highlights",
    "proof",
    "logos",
    "billing"
  ],
  "presets": [
    {
      "name": "Plan cards",
      "shape": "plan-cards",
      "knobs": {
        "introPosition": "top",
        "introAlign": "center",
        "plansColumns": "auto",
        "planFeatures": "inside",
        "planStyle": "card",
        "planAlign": "left",
        "planCta": "top",
        "featured": "outline"
      }
    },
    {
      "name": "Side intro",
      "shape": "side-intro",
      "knobs": {
        "introPosition": "left",
        "introAlign": "left",
        "plansColumns": "2",
        "planFeatures": "inside",
        "planStyle": "card",
        "planAlign": "left",
        "planCta": "top",
        "featured": "outline"
      }
    },
    {
      "name": "Open columns",
      "shape": "open-columns",
      "knobs": {
        "introPosition": "top",
        "introAlign": "center",
        "plansColumns": "auto",
        "planFeatures": "inside",
        "planStyle": "divided",
        "planAlign": "left",
        "planCta": "top",
        "featured": "background"
      }
    },
    {
      "name": "Features below",
      "shape": "features-below",
      "knobs": {
        "introPosition": "top",
        "introAlign": "center",
        "plansColumns": "auto",
        "planFeatures": "below",
        "planStyle": "card",
        "planAlign": "left",
        "planCta": "top",
        "featured": "background"
      }
    },
    {
      "name": "One plan",
      "shape": "one-plan",
      "knobs": {
        "introPosition": "left",
        "introAlign": "left",
        "plansColumns": "1",
        "planFeatures": "inside",
        "planStyle": "card",
        "planAlign": "left",
        "planCta": "bottom",
        "featured": "outline"
      }
    },
    {
      "name": "Rainbow",
      "shape": "rainbow",
      "knobs": {
        "introPosition": "top",
        "introAlign": "center",
        "plansColumns": "auto",
        "planFeatures": "inside",
        "planStyle": "card",
        "planAlign": "left",
        "planCta": "top",
        "featured": "outline"
      },
      "colors": {
        "bg": {
          "stops": [
            "#7d52f4",
            "#f7b733"
          ],
          "angle": 135
        },
        "featuredColor": {
          "stops": [
            "#7d52f4",
            "#f7b733"
          ],
          "angle": 135
        }
      }
    }
  ],
  "slots": {
    "options": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{introPosition, introAlign, plansColumns, planFeatures, planStyle, planAlign, planCta, featured}",
      "knobs": [
        {
          "name": "introPosition",
          "values": [
            "left",
            "right",
            "top",
            "bottom"
          ]
        },
        {
          "name": "introAlign",
          "values": [
            "left",
            "center",
            "right"
          ]
        },
        {
          "name": "plansColumns",
          "values": [
            "auto",
            "1",
            "2",
            "3",
            "4"
          ]
        },
        {
          "name": "planFeatures",
          "values": [
            "inside",
            "below"
          ]
        },
        {
          "name": "planStyle",
          "values": [
            "card",
            "divided",
            "plain"
          ]
        },
        {
          "name": "planAlign",
          "values": [
            "left",
            "center",
            "right"
          ]
        },
        {
          "name": "planCta",
          "values": [
            "top",
            "bottom"
          ]
        },
        {
          "name": "featured",
          "values": [
            "outline",
            "background"
          ]
        }
      ]
    },
    "introEyebrow": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{text, style: \"none\" | \"pill\" | \"outline\" | \"dash\" | \"plain\"}",
      "editLabel": {
        "text": "Eyebrow"
      },
      "choices": {
        "style": [
          "none",
          "pill",
          "outline",
          "dash",
          "plain"
        ]
      }
    },
    "headline": {
      "kind": "text",
      "required": false,
      "promptOptional": false,
      "editLabel": "Headline"
    },
    "body": {
      "kind": "text",
      "required": false,
      "promptOptional": true,
      "editLabel": "Text"
    },
    "highlights": {
      "kind": "list",
      "required": false,
      "promptOptional": true,
      "minItems": 1,
      "maxItems": 4,
      "shape": "[{icon, title, text}]",
      "editLabel": {
        "title": "Highlight title",
        "text": "Highlight text"
      }
    },
    "proof": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{avatars: [{imageUrl}], rating, text}",
      "editLabel": {
        "text": "Review line"
      }
    },
    "logos": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{caption, items: [{imageUrl, alt}]}",
      "editLabel": {
        "caption": "Logos caption"
      }
    },
    "billing": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{monthlyLabel, yearlyLabel, yearlyNote?}",
      "editLabel": {
        "monthlyLabel": "Monthly label",
        "yearlyLabel": "Yearly label",
        "yearlyNote": "Yearly note"
      }
    },
    "plans": {
      "kind": "list",
      "required": true,
      "promptOptional": false,
      "minItems": 1,
      "maxItems": 4,
      "maxTrue": {
        "featured": 1
      },
      "shape": "[{name, price: {monthly, yearly?}, period, description, features: [string], cta: {label, href, style?: \"solid\" | \"outline\"}, featured?: bool, badge?}]",
      "editLabel": {
        "name": "Plan name",
        "period": "Period",
        "description": "Plan description",
        "badge": "Badge"
      }
    },
    "bg": {
      "kind": "color",
      "required": false,
      "promptOptional": true,
      "shape": "\"#rrggbb\" | \"brand\" | {stops: [\"#rrggbb\" (2–3 个)], angle?: number}",
      "swatches": [
        "#ffffff",
        "#f1f5f9",
        "#e0f2fe",
        "brand",
        "#1e293b",
        "#0f172a"
      ]
    },
    "featuredColor": {
      "kind": "color",
      "required": false,
      "promptOptional": true,
      "shape": "\"#rrggbb\" | \"brand\" | {stops: [\"#rrggbb\" (2–3 个)], angle?: number}",
      "swatches": [
        "brand",
        "#dc2626",
        "#16a34a",
        "#0f172a"
      ]
    }
  },
  "industries": {
    "required": [],
    "recommended": [],
    "discouraged": []
  },
  "prompt": {
    "group": "homepage",
    "order": 13,
    "headPrefix": "",
    "headSuffix": "a block head (headline + text) with 1–4 price plans side by side, one of them highlighted",
    "headExtra": null,
    "lines": [
      "@data",
      "plans: 1–4 items, each {name, price: {monthly, yearly?}, period, description, features: [string], cta: {label, href}, featured?, badge?}; take them from the services / packages the site already offers — if you cannot find real prices, leave this block out rather than inventing them; at most ONE plan has featured: true (give it a short badge like \"Most popular\")",
      "price.monthly / price.yearly are display strings (\"$49\"); period is what follows the price (\"/ month\"); only fill price.yearly (the per-month price when paid yearly) and billing {monthlyLabel, yearlyLabel, yearlyNote?} when the business really has a yearly price",
      "highlights: 1–4 items {icon, title, text} under the block head; icon is a Bootstrap Icons name (\"shield-check\", \"clock\", \"award\")",
      "bg is the section background, featuredColor the colour of the highlighted plan; both are top-level in data (not inside options)"
    ]
  },
  "toolbarGroups": [
    ["introPosition", "introAlign", "choice:introEyebrow.style", "part:highlights", "part:proof", "part:logos", "part:billing"],
    ["plansColumns", "planFeatures"],
    ["planStyle", "planAlign", "planCta", "featured", "color:featuredColor"],
    ["color:bg"]
  ]
}
