{
  "type": "cta-new",
  "displayName": "Call to action (Webpixels)",
  "category": "cta",
  "roleDefault": "optional",
  "skin": "site-css",
  "layout_intent": {
    "items": "none",
    "item_wrap": "allow",
    "headline": "none",
    "cross": "none",
    "order": "dom",
    "item_parts": "none",
    "inner": "one"
  },
  "presets": [
    { "name": "Centered", "shape": "centered", "knobs": { "layout": "centered", "frame": "none", "textAlign": "center", "image": "none", "form": "none" } },
    { "name": "Boxed", "shape": "boxed", "knobs": { "layout": "centered", "frame": "boxed", "textAlign": "center", "image": "none", "form": "none" } },
    { "name": "Inline", "shape": "inline", "knobs": { "layout": "inline", "frame": "boxed", "textAlign": "left", "image": "none", "form": "none" } },
    { "name": "Photo", "shape": "photo", "knobs": { "layout": "centered", "frame": "boxed", "textAlign": "left", "image": "left", "form": "none" } },
    { "name": "Lead form", "shape": "lead-form", "knobs": { "layout": "centered", "frame": "boxed", "textAlign": "center", "image": "none", "form": "full" } },
    { "name": "Cover", "shape": "cover", "knobs": { "layout": "inline", "frame": "boxed", "textAlign": "left", "image": "background", "form": "none" } }
  ],
  "slots": {
    "options": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{layout, frame, textAlign, image, form}",
      "knobs": [
        { "name": "layout", "values": ["centered", "inline"] },
        { "name": "frame", "values": ["none", "boxed"] },
        { "name": "textAlign", "values": ["center", "left", "right"] },
        { "name": "image", "values": ["none", "left", "right", "background"] },
        { "name": "form", "values": ["none", "teaser", "full"] }
      ]
    },
    "eyebrow": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{text, style: \"pill\" | \"outline\" | \"dash\" | \"plain\" | \"none\"}",
      "editLabel": {
        "text": "Eyebrow"
      },
      "choices": {
        "style": ["pill", "outline", "dash", "plain", "none"]
      }
    },
    "headline": {
      "kind": "text",
      "required": true,
      "promptOptional": false,
      "editLabel": "Headline"
    },
    "body": {
      "kind": "text",
      "required": false,
      "promptOptional": true,
      "editLabel": "Text"
    },
    "ctas": {
      "kind": "list",
      "required": false,
      "promptOptional": true,
      "shape": "[{label, href, style: \"solid\" | \"outline\" | \"link\", icon?, arrow?, size?}]",
      "editLabel": {
        "label": "Button text"
      },
      "max": 2
    },
    "image": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{imageUrl, alt}"
    },
    "form": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{id?}"
    },
    "bg": {
      "kind": "color",
      "required": false,
      "promptOptional": true,
      "shape": "\"#rrggbb\" | \"brand\" | {stops: [\"#rrggbb\" (2–3 个)], angle?: number}",
      "swatches": ["#ffffff", "#f1f5f9", "#e0f2fe", "brand", "#1e293b", "#0f172a"]
    }
  },
  "industries": {
    "required": [],
    "recommended": [],
    "discouraged": []
  },
  "prompt": {
    "group": "homepage",
    "order": 16,
    "headPrefix": "",
    "headSuffix": "a call-to-action band with presets that can go anywhere on a page",
    "headExtra": null,
    "lines": [
      "@data",
      "on the homepage put one Boxed after the features; on inner pages put one Inline at the end",
      "the form only shows when options.form is \"teaser\" (phone + button) or \"full\" — with a form the ctas are not shown; bg is the background colour, top-level in data (not inside options)"
    ]
  }
}
