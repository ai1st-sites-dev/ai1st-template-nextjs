{
  "type": "milestones",
  "displayName": "Milestones",
  "category": "stats",
  "roleDefault": "optional",
  "skin": "site-css",
  "layout_intent": {
    "items": "row",
    "item_wrap": "allow",
    "headline": "above",
    "cross": "none",
    "order": "dom",
    "item_parts": "stack",
    "inner": "many"
  },
  "presets": [
    {
      "name": "Row",
      "shape": "divided-row",
      "knobs": {
        "blockImage": "none",
        "introPosition": "top",
        "introAlign": "center",
        "introImage": "none",
        "statsColumns": "auto",
        "statSize": "md",
        "statStyle": "divided",
        "statAlign": "center"
      }
    },
    {
      "name": "Side intro",
      "shape": "side-intro",
      "knobs": {
        "blockImage": "none",
        "introPosition": "left",
        "introAlign": "left",
        "introImage": "none",
        "statsColumns": "2",
        "statSize": "md",
        "statStyle": "plain",
        "statAlign": "left"
      }
    },
    {
      "name": "Photo",
      "shape": "photo",
      "knobs": {
        "blockImage": "none",
        "introPosition": "top",
        "introAlign": "left",
        "introImage": "left",
        "statsColumns": "auto",
        "statSize": "md",
        "statStyle": "plain",
        "statAlign": "left"
      }
    },
    {
      "name": "Photo side",
      "shape": "photo-side",
      "knobs": {
        "blockImage": "right",
        "introPosition": "top",
        "introAlign": "center",
        "introImage": "none",
        "statsColumns": "2",
        "statSize": "md",
        "statStyle": "card",
        "statAlign": "center"
      }
    },
    {
      "name": "Big number",
      "shape": "big-number",
      "knobs": {
        "blockImage": "none",
        "introPosition": "bottom",
        "introAlign": "center",
        "introImage": "none",
        "statsColumns": "1",
        "statSize": "xl",
        "statStyle": "plain",
        "statAlign": "center"
      }
    }
  ],
  "slots": {
    "options": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{blockImage, introPosition, introAlign, introImage, statsColumns, statSize, statStyle, statAlign, statIcon: bool}",
      "knobs": [
        {
          "name": "blockImage",
          "values": [
            "none",
            "left",
            "right",
            "background"
          ]
        },
        {
          "name": "introPosition",
          "values": [
            "left",
            "right",
            "top",
            "bottom"
          ]
        },
        {
          "name": "introAlign",
          "values": [
            "left",
            "center",
            "right"
          ]
        },
        {
          "name": "introImage",
          "values": [
            "none",
            "left",
            "right"
          ]
        },
        {
          "name": "statsColumns",
          "values": [
            "auto",
            "1",
            "2",
            "3",
            "4"
          ]
        },
        {
          "name": "statSize",
          "values": [
            "md",
            "xl"
          ]
        },
        {
          "name": "statStyle",
          "values": [
            "plain",
            "card",
            "divided"
          ]
        },
        {
          "name": "statAlign",
          "values": [
            "left",
            "center"
          ]
        }
      ]
    },
    "blockImage": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{imageUrl, alt}"
    },
    "introEyebrow": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{text, style: \"none\" | \"pill\" | \"outline\" | \"dash\" | \"plain\"}",
      "editLabel": {
        "text": "Eyebrow"
      },
      "choices": {
        "style": [
          "none",
          "pill",
          "outline",
          "dash",
          "plain"
        ]
      }
    },
    "headline": {
      "kind": "text",
      "required": false,
      "promptOptional": false,
      "editLabel": "Headline"
    },
    "body": {
      "kind": "text",
      "required": false,
      "promptOptional": true,
      "editLabel": "Text"
    },
    "introCtas": {
      "kind": "list",
      "required": false,
      "promptOptional": true,
      "max": 2,
      "shape": "[{label, href, style: \"solid\" | \"outline\" | \"link\", icon?, arrow?, size?}]",
      "editLabel": {
        "label": "Button text"
      }
    },
    "introImage": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{imageUrl, alt}"
    },
    "stats": {
      "kind": "list",
      "required": true,
      "promptOptional": false,
      "minItems": 1,
      "maxItems": 6,
      "shape": "[{value, label, icon?}]",
      "editLabel": {
        "value": "Number",
        "label": "Label"
      }
    },
    "bg": {
      "kind": "color",
      "required": false,
      "promptOptional": true,
      "shape": "\"#rrggbb\" | \"brand\" | {stops: [\"#rrggbb\" (2–3 个)], angle?: number}",
      "swatches": [
        "#ffffff",
        "#f1f5f9",
        "#e0f2fe",
        "brand",
        "#1e293b",
        "#0f172a"
      ]
    }
  },
  "industries": {
    "required": [],
    "recommended": [],
    "discouraged": []
  },
  "prompt": {
    "group": "homepage",
    "order": 7,
    "headPrefix": "",
    "headSuffix": "a block head (headline + text) with a row of 1–6 big numbers (founding year, jobs done, rating, response time)",
    "headExtra": null,
    "lines": [
      "@data",
      "stats: 1–6 items, each {value, label, icon?}; take them from facts the site already states (year founded, jobs completed, rating, response time) — if you cannot find a real number, leave the block out rather than inventing one; icon is a Bootstrap Icons name (\"calendar-check\", \"star-fill\", \"stopwatch\")",
      "images and icons only show when the matching option is on: blockImage needs options.blockImage, introImage needs options.introImage, stats[].icon needs options.statIcon: true; bg is the background colour, top-level in data (not inside options)"
    ]
  },
  "toolbarGroups": [
    ["blockImage"],
    ["introPosition", "introAlign", "choice:introEyebrow.style", "count:introCtas", "introImage"],
    ["statsColumns", "statSize"],
    ["statStyle", "statAlign", "bool:statIcon"],
    ["color:bg"]
  ]
}
