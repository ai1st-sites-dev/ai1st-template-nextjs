{
  "type": "testimonials",
  "displayName": "Testimonials (Webpixels)",
  "category": "testimonial",
  "roleDefault": "optional",
  "skin": "site-css",
  "layout_intent": {
    "items": "grid",
    "item_wrap": "allow",
    "headline": "above",
    "cross": "none",
    "order": "dom",
    "item_parts": "stack",
    "inner": "many"
  },
  "presets": [
    {
      "name": "Cards",
      "shape": "cards",
      "knobs": {
        "introPosition": "top",
        "introAlign": "center",
        "summaryStyle": "inline",
        "itemsLayout": "grid",
        "itemsColumns": "3",
        "itemStyle": "card",
        "quoteSize": "md",
        "itemAlign": "left"
      }
    },
    {
      "name": "Side intro",
      "shape": "side-intro",
      "knobs": {
        "introPosition": "left",
        "introAlign": "left",
        "summaryStyle": "inline",
        "itemsLayout": "carousel",
        "itemsColumns": "2",
        "itemStyle": "card",
        "quoteSize": "md",
        "itemAlign": "left"
      }
    },
    {
      "name": "Big quote",
      "shape": "big-quote",
      "knobs": {
        "introPosition": "top",
        "introAlign": "center",
        "summaryStyle": "inline",
        "itemsLayout": "carousel",
        "itemsColumns": "1",
        "itemStyle": "plain",
        "quoteSize": "lg",
        "itemAlign": "center"
      }
    },
    {
      "name": "Quote card",
      "shape": "quote-card",
      "knobs": {
        "introPosition": "top",
        "introAlign": "center",
        "summaryStyle": "inline",
        "itemsLayout": "carousel",
        "itemsColumns": "2",
        "itemStyle": "card",
        "quoteSize": "lg",
        "itemAlign": "left"
      }
    },
    {
      "name": "Ratings",
      "shape": "ratings",
      "knobs": {
        "introPosition": "top",
        "introAlign": "left",
        "summaryStyle": "cards",
        "itemsLayout": "grid",
        "itemsColumns": "3",
        "itemStyle": "card",
        "quoteSize": "md",
        "itemAlign": "left"
      },
      "parts": [
        "summary"
      ]
    }
  ],
  "parts": [
    "summary"
  ],
  "slots": {
    "options": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{introPosition, introAlign, summaryStyle, itemsLayout, itemsColumns, itemStyle, quoteSize, itemAlign}",
      "knobs": [
        {
          "name": "introPosition",
          "values": [
            "left",
            "right",
            "top",
            "bottom"
          ]
        },
        {
          "name": "introAlign",
          "values": [
            "left",
            "center",
            "right"
          ]
        },
        {
          "name": "summaryStyle",
          "values": [
            "inline",
            "cards"
          ]
        },
        {
          "name": "itemsLayout",
          "values": [
            "grid",
            "carousel"
          ]
        },
        {
          "name": "itemsColumns",
          "values": [
            "1",
            "2",
            "3"
          ]
        },
        {
          "name": "itemStyle",
          "values": [
            "plain",
            "card"
          ]
        },
        {
          "name": "quoteSize",
          "values": [
            "md",
            "lg"
          ]
        },
        {
          "name": "itemAlign",
          "values": [
            "left",
            "center"
          ]
        }
      ]
    },
    "introEyebrow": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{text, style: \"none\" | \"pill\" | \"outline\" | \"dash\" | \"plain\"}",
      "editLabel": {
        "text": "Eyebrow"
      },
      "choices": {
        "style": [
          "none",
          "pill",
          "outline",
          "dash",
          "plain"
        ]
      }
    },
    "headline": {
      "kind": "text",
      "required": false,
      "promptOptional": false,
      "editLabel": "Headline"
    },
    "body": {
      "kind": "text",
      "required": false,
      "promptOptional": true,
      "editLabel": "Text"
    },
    "summary": {
      "kind": "list",
      "required": false,
      "promptOptional": true,
      "minItems": 1,
      "maxItems": 4,
      "ranges": {
        "rating": [
          0,
          5,
          1
        ],
        "count": [
          1,
          null
        ]
      },
      "shape": "[{source, rating: 0–5, count, href?, logoUrl?}]",
      "editLabel": {
        "source": "Review site",
        "rating": "Rating",
        "count": "Number of reviews"
      },
      "demo": [
        {
          "source": "Google",
          "rating": 4.9,
          "count": 120
        }
      ]
    },
    "items": {
      "kind": "list",
      "required": true,
      "promptOptional": false,
      "minItems": 1,
      "maxItems": 12,
      "generateImages": false,
      "ranges": {
        "rating": [
          1,
          5
        ]
      },
      "shape": "[{quote, name, role?, photo?: {imageUrl, alt}, rating?: 1–5, source?}]",
      "editLabel": {
        "quote": "Quote",
        "name": "Name",
        "role": "Role",
        "source": "Review site"
      }
    },
    "bg": {
      "kind": "color",
      "required": false,
      "promptOptional": true,
      "shape": "\"#rrggbb\" | \"brand\" | {stops: [\"#rrggbb\" (2–3 个)], angle?: number}",
      "swatches": [
        "#ffffff",
        "#f1f5f9",
        "#e0f2fe",
        "brand",
        "#1e293b",
        "#0f172a"
      ]
    }
  },
  "industries": {
    "required": [],
    "recommended": [],
    "discouraged": []
  },
  "prompt": {
    "group": "homepage",
    "order": 11,
    "headPrefix": "",
    "headSuffix": "a block head (headline + text, optional row of review-platform ratings) with 1–12 customer reviews, shown as a grid or a sliding carousel",
    "headExtra": null,
    "lines": [
      "@data",
      "items: 1–12 reviews, each {quote, name, role?, photo?, rating?, source?}; only real reviews taken from the site or given by the owner — never invent one; role is who they are or \"area · service\"; source is the platform the review came from (\"Google\", \"Yelp\", \"HomeStars\"); rating is a whole number 1–5",
      "photo only when the owner uploaded one ({imageUrl, alt}); without it the block shows the person's initials",
      "summary is a list of rating platforms (at most 4), each {source, rating, count, href?, logoUrl?}: source is the platform name (\"Google\", \"Yelp\", \"HomeStars\"), rating its overall score 0–5 with at most one decimal, count how many reviews it has; write href only when you have the link to the business's own page on that platform; write logoUrl only when the owner gave you that platform's logo image — without one leave it out (Google / Yelp / Facebook get a built-in icon automatically, any other platform shows its name); copy the numbers only from what you were given or what the site states (a \"Platform ratings\" line, the brand description, the owner's message) — if none is stated, leave summary out entirely, never make one up; with only one platform write only one; bg is the background colour, top-level in data (not inside options)"
    ]
  },
  "toolbarGroups": [
    ["introPosition", "introAlign", "choice:introEyebrow.style"],
    ["part:summary", "summaryStyle"],
    ["itemsLayout", "itemsColumns"],
    ["itemStyle", "quoteSize", "itemAlign"],
    ["color:bg"]
  ],
  "itemsGrid": {
    "knob": "itemsColumns",
    "phone": 1,
    "tablet": 2,
    "grids": [
      {"container": ".tn-grid", "item": ".tn-item", "when": "[data-items-layout=\"grid\"]"},
      {"container": ".tn-slide", "item": ".tn-item"}
    ]
  },
  "introLayout": {
    "text": ".tn-intro-text",
    "frame": ".tn-frame",
    "introCol": ".tn-introcol",
    "mainCol": ".tn-itemscol",
    "side": "33.3333%",
    "stackGap": "2rem",
    "follow": [
      {"target": ".tn-intro-text .tn-summary", "by": "justify"}
    ]
  }
}
