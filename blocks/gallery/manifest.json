{
  "type": "gallery",
  "displayName": "Gallery (Webpixels)",
  "category": "gallery",
  "roleDefault": "optional",
  "skin": "site-css",
  "layout_intent": {
    "items": "grid",
    "item_wrap": "allow",
    "headline": "above",
    "cross": "none",
    "order": "dom",
    "item_parts": "stack",
    "inner": "many"
  },
  "presets": [
    {
      "name": "Grid",
      "shape": "grid",
      "knobs": {
        "introPosition": "top",
        "introAlign": "center",
        "itemsLayout": "grid",
        "itemsColumns": "3",
        "itemShape": "landscape",
        "itemCaption": "below"
      }
    },
    {
      "name": "Masonry",
      "shape": "masonry",
      "knobs": {
        "introPosition": "top",
        "introAlign": "center",
        "itemsLayout": "grid",
        "itemsColumns": "3",
        "itemShape": "original",
        "itemCaption": "overlay"
      }
    },
    {
      "name": "Mosaic",
      "shape": "mosaic",
      "knobs": {
        "introPosition": "top",
        "introAlign": "left",
        "itemsLayout": "mosaic",
        "itemsColumns": "4",
        "itemShape": "square",
        "itemCaption": "overlay"
      }
    },
    {
      "name": "Side intro",
      "shape": "side-intro",
      "knobs": {
        "introPosition": "left",
        "introAlign": "left",
        "itemsLayout": "grid",
        "itemsColumns": "3",
        "itemShape": "square",
        "itemCaption": "below"
      }
    }
  ],
  "slots": {
    "options": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{introPosition, introAlign, itemsLayout, itemsColumns, itemShape, itemCaption}",
      "knobs": [
        {
          "name": "introPosition",
          "values": [
            "left",
            "right",
            "top",
            "bottom"
          ]
        },
        {
          "name": "introAlign",
          "values": [
            "left",
            "center",
            "right"
          ]
        },
        {
          "name": "itemsLayout",
          "values": [
            "grid",
            "mosaic"
          ]
        },
        {
          "name": "itemsColumns",
          "values": [
            "2",
            "3",
            "4"
          ]
        },
        {
          "name": "itemShape",
          "values": [
            "original",
            "square",
            "landscape",
            "portrait"
          ]
        },
        {
          "name": "itemCaption",
          "values": [
            "below",
            "overlay"
          ]
        }
      ]
    },
    "introEyebrow": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{text, style: \"none\" | \"pill\" | \"outline\" | \"dash\" | \"plain\"}",
      "editLabel": {
        "text": "Eyebrow"
      },
      "choices": {
        "style": [
          "none",
          "pill",
          "outline",
          "dash",
          "plain"
        ]
      }
    },
    "headline": {
      "kind": "text",
      "required": false,
      "promptOptional": false,
      "editLabel": "Headline"
    },
    "body": {
      "kind": "text",
      "required": false,
      "promptOptional": true,
      "editLabel": "Text"
    },
    "items": {
      "kind": "list",
      "required": true,
      "promptOptional": false,
      "minItems": 2,
      "maxItems": 24,
      "itemRequires": [
        "image.imageUrl"
      ],
      "shape": "[{image: {imageUrl, alt}, title?, caption?}]",
      "editLabel": {
        "title": "Title",
        "caption": "Caption"
      }
    },
    "bg": {
      "kind": "color",
      "required": false,
      "promptOptional": true,
      "shape": "\"#rrggbb\" | \"brand\" | {stops: [\"#rrggbb\" (2–3 个)], angle?: number}",
      "swatches": [
        "#ffffff",
        "#f1f5f9",
        "#e0f2fe",
        "brand",
        "#1e293b",
        "#0f172a"
      ]
    }
  },
  "industries": {
    "required": [
      "photography"
    ],
    "recommended": [
      "construction",
      "landscaping",
      "restaurant",
      "salon"
    ],
    "discouraged": []
  },
  "prompt": {
    "group": "homepage",
    "order": 14,
    "headPrefix": "",
    "headSuffix": "a block head (headline + text) over a wall of the business's own photos (2–24: finished jobs, the site, the shop front); a visitor clicks one to see it large",
    "headExtra": null,
    "lines": [
      "@data",
      "items: 2–24 photos, each {image: {imageUrl, alt}, title?, caption?}; only photos the owner uploaded (their work, the job site, the shop) — if there are none, leave this block out rather than using stock pictures",
      "title says which job it was (\"Kitchen repipe\"), caption is the place or one short line (\"Burnaby · 2 days\"); bg is the background colour, top-level in data (not inside options)"
    ]
  }
}
