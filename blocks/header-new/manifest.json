{
  "type": "header-new",
  "displayName": "Site Header (Webpixels)",
  "category": "region",
  "region": true,
  "staging": true,
  "roleDefault": "essential",
  "layout_intent": {
    "items": "none",
    "item_wrap": "allow",
    "headline": "none",
    "media": "none",
    "columns": "one"
  },
  "slots": {
    "logo": {
      "kind": "image",
      "required": false,
      "promptOptional": true
    },
    "brandName": {
      "kind": "text",
      "required": true,
      "promptOptional": false
    },
    "nav": {
      "kind": "list",
      "required": true,
      "promptOptional": false,
      "shape": "[{label, href, icon?, show: \"text\" | \"icon\" | \"both\"}]"
    },
    "ctaPrimary": {
      "kind": "link",
      "required": true,
      "promptOptional": false,
      "shape": "{label, href, style: \"solid\" | \"outline\" | \"link\"}"
    },
    "ctaSecondary": {
      "kind": "link",
      "required": false,
      "promptOptional": true,
      "shape": "{label, href, style: \"solid\" | \"outline\" | \"link\"}"
    },
    "topbar": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{contact: [{icon, text, href?}], links: [{label, href}], social: [{label, href, icon}]}"
    },
    "options": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{preset?: string, logo: \"left\" | \"center\", menu: \"right\" | \"center\" | \"split\" | \"gathered\" | \"below\", topbar: \"none\" | \"contact\", reverse: bool, dark: bool, icons: bool}"
    }
  },
  "presets": [
    { "name": "logo-left", "logo": "left", "menu": "right", "topbar": "none" },
    { "name": "menu-center", "logo": "left", "menu": "center", "topbar": "none" },
    { "name": "logo-center-split", "logo": "center", "menu": "split", "topbar": "none" },
    { "name": "logo-center-gathered", "logo": "center", "menu": "gathered", "topbar": "none" },
    { "name": "topbar", "logo": "left", "menu": "right", "topbar": "contact" },
    { "name": "stacked", "logo": "center", "menu": "below", "topbar": "none" },
    { "name": "topbar-stacked", "logo": "center", "menu": "below", "topbar": "contact" }
  ],
  "knobCoupling": ["logo", "menu"],
  "industries": {
    "required": [],
    "recommended": [],
    "discouraged": []
  }
}
