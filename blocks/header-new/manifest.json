{
  "type": "header-new",
  "displayName": "Site Header (Webpixels)",
  "category": "region",
  "region": true,
  "staging": true,
  "roleDefault": "essential",
  "layout_intent": {
    "items": "none",
    "item_wrap": "allow",
    "headline": "none",
    "media": "none",
    "columns": "one"
  },
  "slots": {
    "logo": {
      "kind": "image",
      "required": false,
      "promptOptional": true
    },
    "brandName": {
      "kind": "text",
      "required": true,
      "promptOptional": false
    },
    "nav": {
      "kind": "list",
      "required": true,
      "promptOptional": false,
      "shape": "[{label, href, icon?, show: \"text\" | \"icon\" | \"both\"}]"
    },
    "ctaPrimary": {
      "kind": "link",
      "required": true,
      "promptOptional": false,
      "shape": "{label, href, style: \"solid\" | \"outline\" | \"link\"}"
    },
    "ctaSecondary": {
      "kind": "link",
      "required": false,
      "promptOptional": true,
      "shape": "{label, href, style: \"solid\" | \"outline\" | \"link\"}"
    },
    "topbar": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{contact: [{icon, text, href?}], links: [{label, href}], social: [{label, href, icon}]}"
    },
    "options": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{preset?: string, logo, menu, topbar: bool, dark: bool, icons: bool}",
      "knobs": [
        { "name": "logo", "values": ["left", "center", "right"] },
        { "name": "menu", "values": ["beside", "center", "split", "gathered", "below"] }
      ]
    }
  },
  "presets": [
    { "name": "logo-left", "shape": "logo-left", "knobs": { "logo": "left", "menu": "beside" }, "options": { "topbar": false } },
    { "name": "menu-center", "shape": "menu-center", "knobs": { "logo": "left", "menu": "center" }, "options": { "topbar": false } },
    { "name": "logo-center-split", "shape": "logo-center-split", "knobs": { "logo": "center", "menu": "split" }, "options": { "topbar": false } },
    { "name": "logo-center-gathered", "shape": "logo-center-gathered", "knobs": { "logo": "center", "menu": "gathered" }, "options": { "topbar": false } },
    { "name": "topbar", "shape": "topbar", "knobs": { "logo": "left", "menu": "beside" }, "options": { "topbar": true } },
    { "name": "stacked", "shape": "stacked", "knobs": { "logo": "center", "menu": "below" }, "options": { "topbar": false } },
    { "name": "topbar-stacked", "shape": "topbar-stacked", "knobs": { "logo": "center", "menu": "below" }, "options": { "topbar": true } }
  ],
  "knobCoupling": ["logo", "menu"],
  "industries": {
    "required": [],
    "recommended": [],
    "discouraged": []
  }
}
