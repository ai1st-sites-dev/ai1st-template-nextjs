{
  "type": "social-proof",
  "displayName": "Social Proof",
  "category": "testimonial",
  "roleDefault": "optional",
  "slots": {
    "headline": {
      "kind": "text",
      "required": true,
      "promptOptional": false,
      "editLabel": "Headline"
    },
    "overallRating": {
      "kind": "text",
      "required": true,
      "promptOptional": false,
      "shape": "\"4.9\"",
      "editLabel": "Overall rating"
    },
    "totalReviews": {
      "kind": "text",
      "required": true,
      "promptOptional": false,
      "shape": "\"500+\"",
      "editLabel": "Total reviews"
    },
    "platforms": {
      "kind": "list",
      "required": false,
      "promptOptional": true,
      "shape": "[{name, rating, reviews}]",
      "editLabel": {
        "name": "Platform name"
      }
    },
    "badges": {
      "kind": "list",
      "required": false,
      "promptOptional": true,
      "shape": "[string]",
      "editLabel": "Badge"
    },
    "featuredQuote": {
      "kind": "object",
      "required": false,
      "promptOptional": true,
      "shape": "{text, author}",
      "editLabel": {
        "text": "Quote",
        "author": "Quote author"
      }
    },
    "stats": {
      "kind": "list",
      "required": false,
      "promptOptional": true,
      "shape": "[{value:\"500+\", label:\"Projects Completed\"}]",
      "editLabel": {
        "value": "Stat number",
        "label": "Stat label"
      }
    },
    "imageUrl": {
      "kind": "image",
      "required": false,
      "promptOptional": true,
      "shape": "string"
    }
  },
  "industries": {
    "required": [],
    "recommended": [],
    "discouraged": []
  },
  "prompt": {
    "group": "homepage",
    "order": 10,
    "headPrefix": "",
    "headSuffix": "",
    "headExtra": null,
    "lines": [
      "@data"
    ]
  }
}
