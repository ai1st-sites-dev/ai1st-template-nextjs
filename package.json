{
  "name": "ai1st-jamstack",
  "version": "1.0.0",
  "description": "JAMstack template system — config-driven static websites",
  "scripts": {
    "predev": "node scripts/sync-config.js",
    "dev": "next dev",
    "prebuild": "node scripts/sync-config.js && node scripts/move-build-output.js backup",
    "build": "next build --webpack && node scripts/move-build-output.js restore",
    "start": "next start",
    "lint:scripts": "eslint scripts/create-site.js scripts/edit-site.js"
  },
  "keywords": [
    "security systems",
    "surveillance",
    "alarm systems",
    "smart home"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "jimp": "^0.22.12",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "autoprefixer": "^10.4.24",
    "eslint": "^8.57.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
}
